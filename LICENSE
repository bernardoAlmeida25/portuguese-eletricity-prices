<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
(function () {
  "use strict";
  const $ = (s) => document.querySelector(s);
  const MONTHS = ["jan","fev","mar","abr","mai","jun","jul","ago","set","out","nov","dez"];
  const DOW = ["Seg","Ter","Qua","Qui","Sex","Sáb","Dom"];
  let S = null, unit = "mwh", rangeDays = 365, charts = [];

  const K = () => (unit === "kwh" ? 0.1 : 1);
  const U = () => (unit === "kwh" ? "c€/kWh" : "€/MWh");
  const ND = () => (unit === "kwh" ? 2 : 1);
  const nf = (v, d) => v == null ? "–" : v.toLocaleString("pt-PT", { minimumFractionDigits: d, maximumFractionDigits: d });
  const fv = (v) => v == null ? "–" : nf(v * K(), ND());
  const sv = (arr) => arr.map((v) => v == null ? null : +(v * K()).toFixed(4));
  const fdate = (s) => s.split("-").reverse().join("/");
  const mlabel = (m) => MONTHS[+m.slice(5, 7) - 1] + " " + m.slice(2, 4);
  const css = (n) => getComputedStyle(document.documentElement).getPropertyValue(n).trim();

  function mk(id, cfg) {
    const c = new Chart($(id), cfg);
    charts.push(c);
    return c;
  }
  function baseOpts(extra) {
    return Object.assign({
      responsive: true, maintainAspectRatio: false, animation: false,
      interaction: { mode: "index", intersect: false },
      plugins: { legend: { labels: { boxWidth: 12, color: css("--muted") } } },
    }, extra || {});
  }
  function axis(title, extra) {
    return Object.assign({
      grid: { color: css("--line") },
      ticks: { color: css("--muted") },
      title: title ? { display: true, text: title, color: css("--muted") } : { display: false },
    }, extra || {});
  }

  /* ---------------------------------------------------------- KPIs */
  function delta(cur, ref) {
    if (cur == null || ref == null || ref === 0) return "";
    const p = (cur - ref) / Math.abs(ref) * 100;
    const cls = p > 0 ? "up" : "down";
    return `<span class="${cls}">${p > 0 ? "▲" : "▼"} ${nf(Math.abs(p), 1)}%</span>`;
  }
  function renderKpis() {
    const k = S.kpis;
    const card = (label, value, note) =>
      `<div class="card kpi"><div class="label">${label}</div><div class="value">${value}<span class="unit"> ${U()}</span></div><div class="note">${note || "&nbsp;"}</div></div>`;
    const html = [
      card("Último dia (" + fdate(k.last_date) + ")", fv(k.last_avg),
        k.prev_avg != null ? delta(k.last_avg, k.prev_avg) + " vs dia anterior" : ""),
      card("Média 7 dias", fv(k.avg7), ""),
      card("Média 30 dias", fv(k.avg30),
        k.avg30_prev_year != null ? delta(k.avg30, k.avg30_prev_year) + " vs ano anterior" : "sem ano anterior ainda"),
      card("Dia mais caro", fv(k.max_day.avg), fdate(k.max_day.date)),
      card("Dia mais barato", fv(k.min_day.avg), fdate(k.min_day.date)),
      `<div class="card kpi"><div class="label">Horas com preço ≤ 0 (30 d)</div><div class="value">${nf(k.nonpositive_hours_30d, 1)}<span class="unit"> h</span></div><div class="note">${
        k.pct_days_cheaper_than_last != null ? "último dia mais barato que " + nf(100 - k.pct_days_cheaper_than_last, 0) + "% dos dias do último ano" : "&nbsp;"
      }</div></div>`,
    ];
    $("#kpis").innerHTML = html.join("");
  }

  /* ---------------------------------------------------------- último dia */
  function renderLatest() {
    const L = S.latest;
    $("#latest-desc").textContent = "Preço de cada " + (L.resolution_min === 60 ? "hora" : "período de 15 minutos") +
      " no último dia publicado (" + fdate(L.date) + ", horas de Lisboa). Verde = janela mais barata de 3 h; vermelho = mais cara.";
    const pills = [];
    if (L.cheap) pills.push(`<span class="pill good">Mais barata: ${L.cheap.start}–${L.cheap.end} · ${fv(L.cheap.avg)} ${U()}</span>`);
    if (L.expensive) pills.push(`<span class="pill bad">Mais cara: ${L.expensive.start}–${L.expensive.end} · ${fv(L.expensive.avg)} ${U()}</span>`);
    $("#latest-pills").innerHTML = pills.join("");
    const good = css("--good"), bad = css("--bad"), acc = css("--accent");
    const colors = L.times.map((_, i) =>
      L.cheap && i >= L.cheap.from_idx && i <= L.cheap.to_idx ? good :
      L.expensive && i >= L.expensive.from_idx && i <= L.expensive.to_idx ? bad : acc);
    mk("#c-latest", {
      type: "bar",
      data: { labels: L.times, datasets: [{ label: "Portugal (" + U() + ")", data: sv(L.pt), backgroundColor: colors, borderWidth: 0, categoryPercentage: 1, barPercentage: 0.9 }] },
      options: baseOpts({
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: {
            label: (c) => "Portugal: " + nf(c.parsed.y, ND()) + " " + U(),
            afterLabel: (c) => L.es[c.dataIndex] !== L.pt[c.dataIndex] ? "Espanha: " + nf(L.es[c.dataIndex] * K(), ND()) + " " + U() : "",
          } },
        },
        scales: { x: axis(null, { ticks: { color: css("--muted"), maxTicksLimit: 12, autoSkip: true, maxRotation: 0 } }), y: axis(U()) },
      }),
    });
  }

  /* ---------------------------------------------------------- diário */
  let dailyChart = null;
  function renderDaily() {
    const D = S.daily;
    const n = D.date.length;
    const from = rangeDays > 0 ? Math.max(0, n - rangeDays) : 0;
    const labels = D.date.slice(from).map(fdate);
    const a = css("--accent");
    const cfg = {
      type: "line",
      data: { labels, datasets: [
        { label: "Máximo", data: sv(D.max.slice(from)), borderWidth: 0, pointRadius: 0, fill: false },
        { label: "Intervalo do dia (mín–máx)", data: sv(D.min.slice(from)), borderWidth: 0, pointRadius: 0, fill: "-1", backgroundColor: css("--accent-soft") },
        { label: "Média diária", data: sv(D.avg.slice(from)), borderColor: a, borderWidth: 1.2, pointRadius: 0, tension: 0 },
        { label: "Média móvel 7 d", data: sv(D.ma7.slice(from)), borderColor: css("--warn"), borderWidth: 2.2, pointRadius: 0, tension: 0.2 },
      ] },
      options: baseOpts({
        plugins: {
          legend: { labels: { boxWidth: 12, color: css("--muted"), filter: (i) => i.datasetIndex !== 0 } },
          tooltip: { callbacks: { label: (c) => c.dataset.label + ": " + nf(c.parsed.y, ND()) + " " + U() } },
        },
        scales: { x: axis(null, { ticks: { color: css("--muted"), maxTicksLimit: 8, autoSkip: true, maxRotation: 0 } }), y: axis(U()) },
      }),
    };
    dailyChart = mk("#c-daily", cfg);
  }

  /* ---------------------------------------------------------- mensal / anual */
  function renderMonthly() {
    const M = S.monthly, a = css("--accent");
    mk("#c-monthly", {
      type: "bar",
      data: { labels: M.month.map(mlabel), datasets: [{ label: U(), data: sv(M.avg), borderWidth: 0,
        backgroundColor: M.full.map((f) => f ? a : css("--accent-soft")) }] },
      options: baseOpts({
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => nf(c.parsed.y, ND()) + " " + U() + (M.full[c.dataIndex] ? "" : " (mês incompleto)") } } },
        scales: { x: axis(null, { ticks: { color: css("--muted"), maxTicksLimit: 12, autoSkip: true, maxRotation: 0 } }), y: axis(U()) },
      }),
    });
    const palette = [css("--muted"), css("--es"), css("--warn"), a];
    const years = Object.keys(S.yoy);
    mk("#c-yoy", {
      type: "line",
      data: { labels: MONTHS, datasets: years.map((y, i) => ({
        label: y, data: sv(S.yoy[y]), borderColor: palette[palette.length - years.length + i],
        borderWidth: i === years.length - 1 ? 3 : 1.6, pointRadius: 2, spanGaps: false, tension: 0.2 })) },
      options: baseOpts({
        plugins: { tooltip: { callbacks: { label: (c) => c.dataset.label + ": " + nf(c.parsed.y, ND()) + " " + U() } } },
        scales: { x: axis(null), y: axis(U()) },
      }),
    });
  }

  /* ---------------------------------------------------------- perfis */
  function renderProfiles() {
    const hours = Array.from({ length: 24 }, (_, h) => String(h).padStart(2, "0") + "h");
    const P = S.profile;
    mk("#c-profile", {
      type: "line",
      data: { labels: hours, datasets: [
        { label: "Últimos 30 dias", data: sv(P.last30), borderColor: css("--accent"), borderWidth: 3, pointRadius: 0, tension: 0.3 },
        { label: "Últimos 12 meses", data: sv(P.last365), borderColor: css("--muted"), borderWidth: 2, pointRadius: 0, tension: 0.3 },
        { label: "Dias úteis (12 m)", data: sv(P.weekday365), borderColor: css("--warn"), borderWidth: 1.5, borderDash: [5, 4], pointRadius: 0, tension: 0.3 },
        { label: "Fins de semana (12 m)", data: sv(P.weekend365), borderColor: css("--es"), borderWidth: 1.5, borderDash: [5, 4], pointRadius: 0, tension: 0.3 },
      ] },
      options: baseOpts({
        plugins: { tooltip: { callbacks: { label: (c) => c.dataset.label + ": " + nf(c.parsed.y, ND()) + " " + U() } } },
        scales: { x: axis(null, { ticks: { color: css("--muted"), maxTicksLimit: 12, autoSkip: true, maxRotation: 0 } }), y: axis(U()) },
      }),
    });
    mk("#c-dow", {
      type: "bar",
      data: { labels: DOW, datasets: [{ label: U(), data: sv(S.dow), backgroundColor: DOW.map((_, i) => i >= 5 ? css("--es") : css("--accent")), borderWidth: 0 }] },
      options: baseOpts({
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => nf(c.parsed.y, ND()) + " " + U() } } },
        scales: { x: axis(null), y: axis(U()) },
      }),
    });
  }

  /* ---------------------------------------------------------- heatmap */
  function renderHeat() {
    const H = S.heatmap;
    const flat = H.values.flat().filter((v) => v != null);
    const el = $("#heat");
    if (!flat.length) { el.innerHTML = ""; return; }
    const lo = Math.min.apply(null, flat), hi = Math.max.apply(null, flat);
    const color = (v) => {
      if (v == null) return "transparent";
      const t = hi === lo ? 0.5 : (v - lo) / (hi - lo);
      return `hsl(${Math.round(125 - 125 * t)},${60 + Math.round(10 * t)}%,${55 - Math.round(3 * t)}%)`;
    };
    let h = "<table><thead><tr><th></th>";
    for (let i = 0; i < 24; i++) h += `<th>${String(i).padStart(2, "0")}</th>`;
    h += "</tr></thead><tbody>";
    H.months.forEach((m, r) => {
      h += `<tr><th class="m">${mlabel(m)}</th>`;
      H.values[r].forEach((v, i) => {
        const txt = v == null ? "" : unit === "kwh" ? nf(v * 0.1, 1) : nf(v, 0);
        h += `<td style="background:${color(v)}" title="${mlabel(m)} · ${String(i).padStart(2, "0")}h: ${fv(v)} ${U()}">${txt}</td>`;
      });
      h += "</tr>";
    });
    el.innerHTML = h + "</tbody></table>";
    $("#heat-lo").textContent = fv(lo) + " " + U();
    $("#heat-hi").textContent = fv(hi) + " " + U();
  }

  /* ---------------------------------------------------------- preços <=0 e spread */
  function renderNonposSpread() {
    const N = S.nonpositive;
    $("#nonpos-desc").textContent = "Total no histórico: " + nf(N.total_hours, 1) + " horas. Acontece sobretudo na primavera, com muito solar, vento e pouca procura.";
    mk("#c-nonpos", {
      type: "bar",
      data: { labels: N.months.map(mlabel), datasets: [{ label: "Horas", data: N.hours, backgroundColor: css("--good"), borderWidth: 0 }] },
      options: baseOpts({
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => nf(c.parsed.y, 1) + " h (" + nf(N.share_pct[c.dataIndex], 1) + "% do tempo)" } } },
        scales: { x: axis(null, { ticks: { color: css("--muted"), maxTicksLimit: 10, autoSkip: true, maxRotation: 0 } }), y: axis("horas") },
      }),
    });
    const P = S.spread;
    mk("#c-spread", {
      data: { labels: P.months.map(mlabel), datasets: [
        { type: "bar", label: "Períodos com preços diferentes (%)", data: P.separation_pct, backgroundColor: css("--es"), borderWidth: 0, yAxisID: "y" },
        { type: "line", label: "Diferença média absoluta (" + U() + ")", data: sv(P.mean_abs_spread), borderColor: css("--warn"), borderWidth: 2, pointRadius: 0, tension: 0.2, yAxisID: "y1" },
      ] },
      options: baseOpts({
        scales: {
          x: axis(null, { ticks: { color: css("--muted"), maxTicksLimit: 10, autoSkip: true, maxRotation: 0 } }),
          y: axis("%", { beginAtZero: true }),
          y1: axis(U(), { position: "right", beginAtZero: true, grid: { drawOnChartArea: false, color: css("--line") } }),
        },
      }),
    });
  }

  function renderRankings() {
    const row = (r, i) => `<tr><td>${i + 1}. ${fdate(r.date)}</td><td>${fv(r.avg)} ${U()}</td></tr>`;
    $("#rank-exp").innerHTML = S.rankings.expensive.map(row).join("");
    $("#rank-cheap").innerHTML = S.rankings.cheap.map(row).join("");
  }

  /* ---------------------------------------------------------- orquestração */
  function renderAll() {
    charts.forEach((c) => c.destroy());
    charts = [];
    Chart.defaults.color = css("--muted");
    Chart.defaults.font.family = "system-ui,-apple-system,'Segoe UI',Roboto,sans-serif";
    renderKpis(); renderLatest(); renderDaily(); renderMonthly(); renderProfiles();
    renderHeat(); renderNonposSpread(); renderRankings();
  }

  function setPressed(group, el) {
    group.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", b === el ? "true" : "false"));
  }

  fetch("data/stats.json", { cache: "no-cache" })
    .then((r) => { if (!r.ok) throw new Error(r.status); return r.json(); })
    .then((json) => {
      S = json;
      const m = S.meta;
      $("#sub").textContent = "Mercado diário OMIE · zona Portugal · " + fdate(m.first_date) + " a " + fdate(m.last_date) + " · " + m.days.toLocaleString("pt-PT") + " dias";
      $("#gen").textContent = "atualizado em " + new Date(m.generated_at).toLocaleString("pt-PT", { dateStyle: "short", timeStyle: "short" });
      renderAll();
      $("#u-mwh").addEventListener("click", (e) => { unit = "mwh"; setPressed(e.target.parentNode, e.target); renderAll(); });
      $("#u-kwh").addEventListener("click", (e) => { unit = "kwh"; setPressed(e.target.parentNode, e.target); renderAll(); });
      $("#range").addEventListener("click", (e) => {
        const b = e.target.closest("button"); if (!b) return;
        rangeDays = +b.dataset.r; setPressed($("#range"), b);
        if (dailyChart) { dailyChart.destroy(); charts = charts.filter((c) => c !== dailyChart); }
        renderDaily();
      });
      if (window.matchMedia) {
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", renderAll);
      }
    })
    .catch((e) => { console.error(e); $("#err").style.display = "block"; $("#sub").textContent = ""; });
})();
</script>
</body>
</html>