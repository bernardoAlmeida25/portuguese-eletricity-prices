  .legend .bar { flex:0 0 160px; height:10px; border-radius:5px; background:linear-gradient(90deg,hsl(125,60%,55%),hsl(60,65%,55%),hsl(0,70%,52%)); }
  table.rank { width:100%; border-collapse:collapse; font-size:.9rem; }
  table.rank td { padding:5px 0; border-bottom:1px solid var(--line); }
  table.rank td:last-child { text-align:right; font-variant-numeric:tabular-nums; }
